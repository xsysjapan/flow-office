APP_NAME=flow-office
APP_ENV=local
APP_KEY=base64:rm84XxT+fCZfW3PSYO6R7OwURBuSohfT1Qvz8zwgh5c=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_API_PREFIX=api

# フロントエンド(別アプリ)のURL。Entra ID SSOコールバック後のリダイレクト先として使う。
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# docker(docker compose up)で起動する場合は.devcontainer/start.shが初回起動時に
# DB_CONNECTION=mysqlへ書き換え、下記のdocker-compose.ymlのdbサービスに接続する。
# dockerを経由しない通常起動(ホストで直接php artisanを実行する等)ではsqliteのままでよい。
DB_CONNECTION=sqlite
DB_HOST=db
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Microsoft Entra ID SSO (docs/06-usecases-auth.md UC-000/UC-001) ---
# 本番・検証環境ではここを設定しない。SSOログイン・MS365ユーザー同期・メール通知が共有する
# Entra IDの資格情報(テナントID・クライアントID・クライアントシークレット・リダイレクトURI)は
# `system_settings`(DB)で管理し、初回オンボーディング画面(未認証で開ける
# `POST /api/onboarding`)から登録する。
#
# 以下はローカル開発・devcontainer・E2Eテストでmock-oidc/を使う場合の値としてのみ使われる。
# `SystemSetting::current()`が初回作成時にここから読み込み、システムをオンボーディング済みの
# 状態でシードする(devcontainer.jsonのpostCreateCommandで自動設定される)。
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI="${APP_URL}/api/auth/microsoft/callback"

# ローカル開発でEntra IDの代わりにmock-oidc/のモックサーバーでログインしたい場合はtrueにする。
# devcontainer/docker-compose環境ではdevcontainer.jsonのpostCreateCommandで自動設定される。
# 本番・検証環境では設定しないこと。
MICROSOFT_MOCK_ENABLED=false
MICROSOFT_MOCK_PUBLIC_BASE_URL=http://localhost:9000
MICROSOFT_MOCK_INTERNAL_BASE_URL=http://mock-oidc:9000

# --- 外部連携(freee/マネーフォワード)のエンドポイントURL ---
# config/external_integrations.php が env() から読み込む。未設定時は本番の実エンドポイント
# (accounts.secure.freee.co.jp / api.freee.co.jp / expense.moneyforward.com)が既定値になる。
# 認証情報(client_id/client_secret/api_key/access_token等)は`external_integration_connections`
# テーブル(管理画面 `/admin/external-integration-connections`)で管理し、ここでは設定しない。
#
# E2E/ローカル開発でmock-freee/・mock-moneyforward/のモックサーバーへ送信先を切り替えたい
# 場合は、以下のコメントを外して`http://localhost:9001/...`・`http://localhost:9002/...`に
# 向ける(docker-compose経由で起動する場合は、docker-compose.yml側の`app`サービスの
# environmentで`http://mock-freee:9001/...`・`http://mock-moneyforward:9002/...`へ
# 既に上書きされているため、ここを変更する必要はない)。本番・検証環境では設定しないこと。
# FREEE_TOKEN_ENDPOINT=http://localhost:9001/public_api/token
# FREEE_ATTENDANCE_API_ENDPOINT=http://localhost:9001/hr/api/v1/employees/{employee_id}/work_record_summaries/{year}/{month}
# FREEE_EXPENSE_API_ENDPOINT=http://localhost:9001/api/1/deals
# MF_EXPENSE_TOKEN_ENDPOINT=http://localhost:9002/oauth/token
# MF_EXPENSE_EX_TRANSACTIONS_ENDPOINT=http://localhost:9002/api/external/v1/offices/{office_id}/office_members/{office_member_id}/ex_transactions
# MF_EXPENSE_UPLOAD_RECEIPT_ENDPOINT=http://localhost:9002/api/external/v1/offices/{office_id}/office_members/{office_member_id}/upload_receipt

# --- OpenAPI / Swagger UI ---
# ローカル開発ではリクエストの都度ドキュメントを再生成する。本番ではfalseのままにする。
L5_SWAGGER_GENERATE_ALWAYS=true
