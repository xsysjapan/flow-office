# frontend(SPA)用の.htaccess。ビルド時(GitHub Actionsの「Build frontend」ステップ)に
# frontend/dist/.htaccess としてコピーされ、rsyncでそのままデプロイされる。
#
# React Routerのフロントエンドルーティング(/login, /auth/callback 等)へ直接アクセス・
# リロードした際、Apache上に対応する実ファイルが存在せず404になってしまうのを防ぐため、
# 実ファイル・実ディレクトリ以外のリクエストをすべて index.html にフォールバックさせる。

<IfModule mod_rewrite.c>
    RewriteEngine On

    # backend/mcpのpublic/への実体は"_api_public"・"_mcp_public"という名前で
    # シンボリックリンクしてあり(activate-release.sh参照)、URLパスの"api"・"mcp"
    # とはわざと名前を違えている。もし"api"・"mcp"という名前のまま実ディレクトリを
    # 直下に置くと、末尾スラッシュなしで"/flow-office/mcp"のようにアクセスした際、
    # Apache本体(mod_dir)がこのRewriteRuleより先にディレクトリとして扱ってしまい、
    # 301(末尾スラッシュ補完)や403/404で処理を打ち切ってしまう
    # (この不一致はDirectorySlash Off等の.htaccess側の対処では防げなかった。
    # docs/27-release-runbook.md参照)。実ディレクトリの名前をURLパスと違えることで、
    # mod_dirがそもそも「該当ディレクトリへのアクセス」と認識しなくなり、通常の
    # RewriteRuleで確実にフロントコントローラへ振り向けられる。
    RewriteRule ^(api|mcp)$ _$1_public/index.php [L]
    RewriteRule ^(api|mcp)/(.*)$ _$1_public/$2 [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.html [L]
</IfModule>

# 検索エンジンに拾われないようにする(社内システムのため)。ドメインルートのrobots.txtは
# 既存ホームページのものでこのデプロイの管理外なので、HTTPヘッダーでも明示しておく
# (docs/28-github-actions-deploy.md参照)。
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
