# frontend(SPA)用の.htaccess。ビルド時(GitHub Actionsの「Build frontend」ステップ)に
# frontend/dist/.htaccess としてコピーされ、rsyncでそのままデプロイされる。
#
# React Routerのフロントエンドルーティング(/login, /auth/callback 等)へ直接アクセス・
# リロードした際、Apache上に対応する実ファイルが存在せず404になってしまうのを防ぐため、
# 実ファイル・実ディレクトリ以外のリクエストをすべて index.html にフォールバックさせる。
# api/・mcp/ はシンボリックリンク(実ディレクトリ)としてdist配下に存在するため、
# 下記の-f/-d判定で自動的に除外され、それぞれのpublic/.htaccessが引き続き適用される。
<IfModule mod_dir.c>
    # api/・mcp/はシンボリックリンク(実ディレクトリ)としてdist配下に存在するため、
    # DirectorySlashが既定(On)のままだと、末尾スラッシュなしで直下にアクセスした際に
    # 下のRewriteRuleより先にApache本体(mod_dir)が自動的に「%{REQUEST_URI}/」への
    # 301リダイレクトを発行してしまう。POSTのようなボディ付きリクエストがこの301で
    # GETに落ちてしまい、各アプリのフロントコントローラが期待するレスポンス
    # (例: mcp/のPOST 401)を返せなくなる(docs/28-github-actions-deploy.md参照)。
    # DirectorySlashはmod_rewriteのRewriteRuleより先に評価されるため、rewrite側の
    # 対処だけでは防げず、ここで明示的に無効化する必要がある。
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # DirectorySlash Offにした分、api/・mcp/直下への末尾スラッシュなしアクセスは
    # 自動リダイレクトされなくなるが、そのままではディレクトリが見つかった時点で
    # 処理が止まってしまうため、各アプリのindex.phpへメソッド・ボディを保ったまま
    # 内部リライトする。api/・mcp/はシンボリックリンクの実ディレクトリのため、
    # Apacheのディレクトリウォークがmcp/public/.htaccess・backend/public/.htaccess
    # まで一括でマージしてしまい、per-directory相対パスでの`^(api|mcp)$`一致に
    # 依存すると環境によってマッチしないことがあった。REQUEST_URIの絶対パスで
    # 判定することで、per-directory相対パスの解釈に依存せず確実にマッチさせる。
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} /(api|mcp)$
    RewriteRule ^ %1/index.php [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.html [L]
</IfModule>

# 検索エンジンに拾われないようにする(社内システムのため)。ドメインルートのrobots.txtは
# 既存ホームページのものでこのデプロイの管理外なので、HTTPヘッダーでも明示しておく
# (docs/28-github-actions-deploy.md参照)。
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
